root = true

[*]
indent_style = space
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
indent_size = 4

[*.{csproj,props,targets,json,yml,yaml}]
indent_size = 2

# Organização do arquivo

csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

# var

csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Modificadores

dotnet_style_require_accessibility_modifiers = always:warning
csharp_preferred_modifier_order = public,private,protected,internal,file,new,static,abstract,virtual,sealed,readonly,override,extern,unsafe,volatile,async:warning
dotnet_style_readonly_field = true:warning

# Expression-bodied members

csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion

# Convenções de nomenclatura do dotnet runtime

dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_style.camel_case_underscore_prefix.capitalization = camel_case
dotnet_naming_style.camel_case_underscore_prefix.required_prefix = _

dotnet_naming_style.camel_case_s_prefix.capitalization = camel_case
dotnet_naming_style.camel_case_s_prefix.required_prefix = s_

dotnet_naming_style.camel_case_t_prefix.capitalization = camel_case
dotnet_naming_style.camel_case_t_prefix.required_prefix = t_

dotnet_naming_style.interface_prefix.capitalization = pascal_case
dotnet_naming_style.interface_prefix.required_prefix = I

# Tipos, membros e constantes: PascalCase

dotnet_naming_symbols.tipos_e_membros.applicable_kinds = class,struct,enum,property,method,event,namespace,delegate,local_function
dotnet_naming_symbols.tipos_e_membros.applicable_accessibilities = *

dotnet_naming_rule.tipos_e_membros_pascal_case.symbols = tipos_e_membros
dotnet_naming_rule.tipos_e_membros_pascal_case.style = pascal_case
dotnet_naming_rule.tipos_e_membros_pascal_case.severity = warning

dotnet_naming_symbols.constantes.applicable_kinds = field
dotnet_naming_symbols.constantes.required_modifiers = const
dotnet_naming_symbols.constantes.applicable_accessibilities = *

dotnet_naming_rule.constantes_pascal_case.symbols = constantes
dotnet_naming_rule.constantes_pascal_case.style = pascal_case
dotnet_naming_rule.constantes_pascal_case.severity = warning

# Interfaces: IPascalCase

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *

dotnet_naming_rule.interfaces_i_prefix.symbols = interfaces
dotnet_naming_rule.interfaces_i_prefix.style = interface_prefix
dotnet_naming_rule.interfaces_i_prefix.severity = warning

# Campo privado de instância: _camelCase

dotnet_naming_symbols.campos_privados_instancia.applicable_kinds = field
dotnet_naming_symbols.campos_privados_instancia.applicable_accessibilities = private
dotnet_naming_symbols.campos_privados_instancia.required_modifiers =

dotnet_naming_rule.campos_privados_instancia_underscore.symbols = campos_privados_instancia
dotnet_naming_rule.campos_privados_instancia_underscore.style = camel_case_underscore_prefix
dotnet_naming_rule.campos_privados_instancia_underscore.severity = warning

# Campo privado estático: s_camelCase

dotnet_naming_symbols.campos_privados_estaticos.applicable_kinds = field
dotnet_naming_symbols.campos_privados_estaticos.applicable_accessibilities = private
dotnet_naming_symbols.campos_privados_estaticos.required_modifiers = static

dotnet_naming_rule.campos_privados_estaticos_s_prefix.symbols = campos_privados_estaticos
dotnet_naming_rule.campos_privados_estaticos_s_prefix.style = camel_case_s_prefix
dotnet_naming_rule.campos_privados_estaticos_s_prefix.severity = warning

# [ThreadStatic]: t_camelCase

dotnet_naming_symbols.campos_thread_static.applicable_kinds = field
dotnet_naming_symbols.campos_thread_static.applicable_accessibilities = private
dotnet_naming_symbols.campos_thread_static.required_modifiers = static

dotnet_naming_rule.campos_thread_static_t_prefix.symbols = campos_thread_static
dotnet_naming_rule.campos_thread_static_t_prefix.style = camel_case_t_prefix
dotnet_naming_rule.campos_thread_static_t_prefix.severity = none

# Parâmetros e variáveis locais: camelCase

dotnet_naming_symbols.parametros_e_locais.applicable_kinds = parameter,local
dotnet_naming_symbols.parametros_e_locais.applicable_accessibilities = *

dotnet_naming_rule.parametros_e_locais_camel_case.symbols = parametros_e_locais
dotnet_naming_rule.parametros_e_locais_camel_case.style = camel_case
dotnet_naming_rule.parametros_e_locais_camel_case.severity = warning

# Parâmetros de tipo: TPascalCase

dotnet_naming_symbols.parametros_de_tipo.applicable_kinds = type_parameter
dotnet_naming_symbols.parametros_de_tipo.applicable_accessibilities = *

dotnet_naming_rule.parametros_de_tipo_t_prefix.symbols = parametros_de_tipo
dotnet_naming_rule.parametros_de_tipo_t_prefix.style = interface_prefix
dotnet_naming_rule.parametros_de_tipo_t_prefix.severity = suggestion
